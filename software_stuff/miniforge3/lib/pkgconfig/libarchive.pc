prefix=/work3/s215098/BioBuilders2026/software/miniforge3
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.8.7
Cflags: -I${includedir}
Cflags.private: -DLIBARCHIVE_STATIC
Libs: -L${libdir} -larchive
Libs.private: -lcrypto -llzo2 -lzstd -llz4 -lbz2  -lz -L/work3/s215098/BioBuilders2026/software/miniforge3/lib -llzma -L/work3/s215098/BioBuilders2026/software/miniforge3/lib -lxml2
Requires.private: libcrypto
